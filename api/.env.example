# Bearer token for API auth. Skills must send this in the Authorization header.
# Set this to any secret string. Copy it into your project's .env.local as SEAM_API_KEY.
SEAM_API_KEY=your-secret-key-here

# Base URL where your context files are publicly readable.
#
# For a public GitHub repo (recommended starting point):
#   https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main
#
# This means any tool that commits to your repo updates the context automatically.
# GitHub Actions, Linear webhooks, manual commits -- all work.
CONTEXT_BASE_URL=https://raw.githubusercontent.com/your-username/your-repo/main
